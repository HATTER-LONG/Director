      "widgets_values": [
        "[\n  {\n    \"speaker\": \"旁白\",\n    \"text\": \"电台下播后，走廊忽然停了电。值班室的门外，有人在慢慢转动把手。\"\n  },\n  {\n    \"speaker\": \"林岚\",\n    \"text\": \"阿卓，先别开门。老周，你不是说楼里没人了吗？\"\n  },\n  {\n    \"speaker\": \"老周\",\n    \"text\": \"[清嗓子] 我锁的是大门。后面那条楼梯，今天有人检修。\"\n  },\n  {\n    \"speaker\": \"阿卓\",\n    \"text\": \"那你怎么不早说？我刚才还把备用灯借给他们了。\"\n  },\n  {\n    \"speaker\": \"林岚\",\n    \"text\": \"门外的，报一下姓名。你们是哪个班组？\"\n  },\n  {\n    \"speaker\": \"旁白\",\n    \"text\": \"门外没有回答。桌上的内线电话响了，阿卓伸手按下免提。\"\n  },\n  {\n    \"speaker\": \"阿卓\",\n    \"text\": \"喂？我们在值班室。走廊为什么没电？\"\n  },\n  {\n    \"speaker\": \"老周\",\n    \"text\": \"别急着说位置，先问他是谁。\"\n  },\n  {\n    \"speaker\": \"阿卓\",\n    \"text\": \"[咳嗽] 对，你是谁？等等，这电话怎么是我自己的声音？\"\n  },\n  {\n    \"speaker\": \"林岚\",\n    \"text\": \"把桌上那台录音机关了。你下午试线路，用的是不是这段录音？\"\n  },\n  {\n    \"speaker\": \"旁白\",\n    \"text\": \"阿卓按下停止键，电话安静了。门外的人终于喊起来，说备用灯没电，请借灯的人开个门。\"\n  },\n  {\n    \"speaker\": \"老周\",\n    \"text\": \"[叹气] 下次借灯，电池也装进去。\"\n  },\n  {\n    \"speaker\": \"阿卓\",\n    \"text\": \"[笑] 行，这回我亲自送。你们可别把门锁了。\"\n  }\n]",
